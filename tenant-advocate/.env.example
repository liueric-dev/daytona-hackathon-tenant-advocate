# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3001
# Public origin of the web app. Dev: the Vite server. Prod: your deployed URL.
# Used for the CSRF origin check, so it must match what the browser sends.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Google sign-in (required) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application
# Authorized JavaScript origins: http://localhost:5173 (and your prod URL)
GOOGLE_CLIENT_ID=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Optional allowlists (comma-separated). Leave blank to allow any verified Google account.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# --- Model ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Arize AX (tracing + evals) ---
# AX > Space Settings
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=tenant-advocate

# --- Daytona (sandboxed lease parsing) ---
DAYTONA_API_KEY=
# Optional; SDK defaults are used when blank
DAYTONA_API_URL=
DAYTONA_TARGET=

# --- SurrealDB Agent Memory ---
# Studio > Agent Memory > your context. Endpoint is the context host, e.g. https://<host>
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_CONTEXT=
AGENT_MEMORY_API_KEY=

# --- NYC Open Data (optional, raises Socrata rate limits) ---
SOCRATA_APP_TOKEN=
